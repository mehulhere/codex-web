# Optional local settings. Process environment values take precedence.
# Never put real credentials in this example file.
MULTI_ACCOUNT=false

# For a remote development server, choose your own password in .env.
# FARFIELD_AUTH_PIN=
# FARFIELD_AUTH_COOKIE_SECURE=1

# Override only if automatic CLI/socket detection does not fit your installation.
# CODEX_CLI_PATH=/absolute/path/to/codex
# CODEX_IPC_SOCKET=/absolute/path/to/ipc.sock

# Installed startup tests read these from the private service environment file:
# ~/.config/codex-mobile/environment
# CODEX_MOBILE_PWA_URL=https://desktop.example.ts.net
# CODEX_MOBILE_SMOKE_MODEL=gpt-6.1-sol
